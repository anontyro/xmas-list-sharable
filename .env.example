# Postgres connection string (Supabase pooled/transaction-mode URL in production)
DATABASE_URL=postgres://family:family@localhost:5433/family_gifts
# Admin sign-in secret, at least 12 characters. Must be set: the app refuses to start without it.
ADMIN_SECRET=
# Session secret, at least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=
# Used only by integration and e2e tests
TEST_DATABASE_URL=postgres://family:family@localhost:5433/family_gifts_test
